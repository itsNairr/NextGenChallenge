# Copy this file to .env.local and fill in the key.
# Read server side only by src/app/api/portfolio-ai/route.ts.
# Never prefix it with NEXT_PUBLIC_, or the browser would expose it.
OPENROUTER_API_KEY=

# Optional. Defaults to anthropic/claude-sonnet-5.
OPENROUTER_MODEL=

# Optional. Base URL of the portfolio mock API. Defaults to http://localhost:4000.
NEXT_PUBLIC_API_BASE_URL=
